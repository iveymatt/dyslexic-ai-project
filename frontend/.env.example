# ============================================
# Dyslexic Thinking OS / Cognitive Partner — Environment Variables
# ============================================
# Copy this to .env and fill in your values.
# Without these, the app runs in demo mode (localStorage only).

# --- Supabase (free tier at supabase.com) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Stripe (stripe.com) ---
# Your Stripe account: Dyslexic.AI Founders (acct_1ODe9VITgoojQAyd)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your-key-here
VITE_STRIPE_PRO_MONTHLY_PRICE_ID=price_1TC1OUITgoojQAyd5CcHwyJ2
VITE_STRIPE_PRO_ANNUAL_PRICE_ID=price_xxxxx
VITE_STRIPE_TEAM_MONTHLY_PRICE_ID=price_xxxxx
VITE_STRIPE_TEAM_ANNUAL_PRICE_ID=price_xxxxx

# --- Stripe Checkout / Portal (Supabase Edge Functions) ---
VITE_STRIPE_CHECKOUT_URL=https://your-project.supabase.co/functions/v1/create-checkout
VITE_STRIPE_PORTAL_URL=https://your-project.supabase.co/functions/v1/customer-portal

# --- Claude AI (anthropic.com) ---
